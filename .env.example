# Copy this file to .env and fill in real values. Never commit .env.

# Database
DB_URL=jdbc:postgresql://localhost:5432/worksphere
DB_USER=worksphere
DB_PASSWORD=change-me

# Redis (rate limiting and caches; the API still works, unthrottled, if Redis is down)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (domain events via the transactional outbox; the API still works if Kafka is down,
# events wait in the outbox table and are sent when it is back)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Object storage for file attachments (S3-compatible; MinIO in docker-compose)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=worksphere
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=worksphere-files

# Email (Mailpit in docker-compose; use a real SMTP provider in production)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@worksphere.local
FRONTEND_URL=http://localhost:5173
# Development only: also write invitation / reset tokens to the log. Never enable in production.
MAIL_LOG_TOKENS=false

# Auth
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Frontend
FRONTEND_API_URL=http://localhost:8080/api/v1
