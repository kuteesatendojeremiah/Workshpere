{
  "uid": "worksphere-overview",
  "title": "WorkSphere overview",
  "tags": [
    "worksphere"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "description": "Traffic, split by HTTP status.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "all",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        },
        {
          "refId": "B",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Server error rate (5xx)",
      "description": "Alert fires above 5% for 5 minutes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "5xx share",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency (p50 / p95 / p99)",
      "description": "Alert fires when p95 stays above 1 second for 10 minutes.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Database connections",
      "description": "Waiting connections above 0 means requests are queueing for the database.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "active",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "waiting",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_max",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "JVM heap used",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "used",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Outbox: events waiting for Kafka",
      "description": "Both should hover near 0. A growing oldest age means Kafka or the relay is down.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "worksphere_outbox_unpublished",
          "legendFormat": "waiting",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        },
        {
          "refId": "B",
          "expr": "worksphere_outbox_oldest_age_seconds",
          "legendFormat": "oldest (seconds)",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Kafka consumer lag",
      "description": "Messages the consumers are behind. Check the dead-letter topic if it climbs.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kafka_consumer_fetch_manager_records_lag_max)",
          "legendFormat": "max lag",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Redis reachable",
      "description": "0 means rate limiting and caching are off (the API still works).",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "worksphere_redis_up",
          "legendFormat": "up",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Rate-limit rejections / minute",
      "description": "scope=auth are login / register / reset requests.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scope) (rate(worksphere_ratelimit_rejected_total[5m])) * 60",
          "legendFormat": "{{scope}}",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "Payment webhooks by outcome",
      "description": "SIGNATURE_REJECTED values mean forged or misconfigured calls.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(worksphere_billing_webhook_total[15m]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Outbox publishing",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(worksphere_outbox_published_total[5m])",
          "legendFormat": "published/s",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        },
        {
          "refId": "B",
          "expr": "rate(worksphere_outbox_publish_failures_total[5m])",
          "legendFormat": "failures/s",
          "datasource": {
            "type": "prometheus",
            "uid": null
          }
        }
      ]
    }
  ]
}
